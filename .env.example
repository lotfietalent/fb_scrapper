# Firebase Service Account - NE JAMAIS COMMITER LE FICHIER .env RÉEL
# Copier ce fichier en .env et remplir les valeurs

# Option 1 : Chemin vers le fichier serviceAccountKey.json (développement local)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option 2 : Contenu JSON encodé en base64 (GitHub Actions)
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 du serviceAccountKey.json>

FIREBASE_PROJECT_ID=dourous-84a2e

# Configuration du scraper (optionnel - valeurs par défaut dans config.js)
# MAX_NEW_POSTS_PER_PAGE=10
# MAX_POSTS_PER_PAGE=100
# RETENTION_DAYS=90

